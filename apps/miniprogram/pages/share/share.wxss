.wrap {
  max-width: 560px;
  margin: 0 auto;
  padding: 20px 16px 40px;
}

.loading,
.failed {
  text-align: center;
  color: #6b7280;
  padding: 80px 0;
  font-size: 14px;
}

.failed__icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.kind {
  display: inline-block;
  font-size: 12px;
  color: #6b7280;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  padding: 2px 8px;
  margin-bottom: 12px;
}

.title {
  font-size: 22px;
  line-height: 1.4;
  font-weight: 700;
  color: #1a1d29;
  margin-bottom: 16px;
}

.card {
  background: #fff;
  border-radius: 14px;
  padding: 20px 18px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.meta-row {
  font-size: 14px;
  color: #4b5563;
  margin: 4px 0;
}

.rsvp {
  margin-top: 18px;
  border-top: 1px solid #eee;
  padding-top: 16px;
}

.rsvp__title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 10px;
}

.rsvp__input {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  font-size: 15px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  margin-bottom: 10px;
}

.rsvp__btns {
  display: flex;
  gap: 8px;
}

.rsvp__btn {
  flex: 1;
  padding: 10px 0;
  font-size: 14px;
  border-radius: 8px;
  border: 1px solid #d1d5db;
  background: #fff;
  color: #1a1d29;
}

.rsvp__btn--yes {
  background: #059669;
  border-color: #059669;
  color: #fff;
}

.rsvp__done {
  color: #059669;
  font-size: 14px;
  text-align: center;
  margin-top: 14px;
}

.rsvp__error {
  color: #dc2626;
  font-size: 13px;
  margin-top: 8px;
}

.content {
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 15px;
  line-height: 1.7;
}

.brand {
  margin-top: 28px;
  text-align: center;
  font-size: 13px;
  color: #9ca3af;
}

.brand__link {
  color: #059669;
  font-weight: 600;
}

.views {
  text-align: center;
  font-size: 12px;
  color: #c0c4cc;
  margin-top: 8px;
}
