# server/.env.example — copy to server/.env and customize.
# Lines starting with # are comments. Required for prod; optional keys show defaults.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Core                                                                     │
# └──────────────────────────────────────────────────────────────────────────┘
DATABASE_URL=postgres://user:pass@localhost:5432/weavine
PORT=3000
# Path to a directory holding migrations + uploaded media. Defaults to /var/lib/weavine.
WEAVINE_DATA_DIR=/var/lib/weavine
# Static frontend served at /. Defaults to ../apps/web-spa/dist (dev).
WEAVINE_SPA_DIR=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ JWT signing keys — required for prod.                                    │
# │ Generate with: openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048 │
# │                 openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem│
# └──────────────────────────────────────────────────────────────────────────┘
JWT_PRIVATE_KEY_PATH=/etc/weavine/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/etc/weavine/jwt-public.pem
# Only used in dev; allows the binary to derive a stable key from a seed if real keys are absent.
WEAVINE_DEV_MASTER_SEED=
# Required. Salts the SHA-256 of the client IP into install_activation.last_ip_hash
# (see AGENTS.md "Activation tracking"). The server refuses to start without it
# to prevent globally-stable IP hashes that could be rainbow-tabled. Generate
# with: openssl rand -hex 32
WEAVINE_JWT_SECRET=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Master key for encrypting api_key plaintext at rest.                     │
# │ Generate with: openssl rand -hex 32                                       │
# │ REQUIRED in prod. If unset, the server logs a warning + refuses new keys. │
# └──────────────────────────────────────────────────────────────────────────┘
WEAVINE_MASTER_KEY=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Cloud OCR (`ocr` feature) — Tesseract via leptess server-side.            │
# │ Free, no per-call API cost.                                               │
# └──────────────────────────────────────────────────────────────────────────┘
# Directory holding *.traineddata files (chi_sim, eng). Default paths probed automatically.
TESSDATA_PREFIX=
# Languages to load. Default: chi_sim+eng. chi_tra dropped since v1.0.5 (rarely used on mainland).
TESS_LANGS=chi_sim+eng

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Cloud STT (`stt` feature) — whisper.cpp tiny, free, runs on CPU.          │
# │ First-run: scripts/install-whisper-model.sh (~75 MB, Apache-2.0).        │
# │ Runtime dep: `ffmpeg` must be on PATH (symphonia lacks opus codec).       │
# └──────────────────────────────────────────────────────────────────────────┘
# Whisper ggml model file. Default: /var/lib/weavine/models/ggml-tiny.bin.
WHISPER_MODEL=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Service key — shared secret enabling zero-login OCR/STT for any Tauri    │
# │ client. Embedded in the Tauri binary at build time via the `WV_SERVICE_KEY`│
# │ env var passed to `cargo build`. If unset at build time, the Tauri client │
# │ degrades gracefully (returns "未登录云端" until the server is configured). │
# │                                                                          │
# │ Server-side: if unset at startup, the server auto-generates a random key │
# │ and logs it ONCE to stderr. Operators should pin it via env so the value │
# │ stays stable across rebuilds.                                            │
# │                                                                          │
# │ Format: any non-empty string. Convention: base62, 32+ chars.              │
# │ Generate: openssl rand -base64 48 | tr -d '=+/' | cut -c1-48               │
# │                                                                          │
# │ PRIVACY: anyone holding this key can call OCR/STT against your server    │
# │ without auth. Treat it like a database password.                          │
# └──────────────────────────────────────────────────────────────────────────┘
WV_SERVICE_KEY=

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Misc                                                                     │
# └──────────────────────────────────────────────────────────────────────────┘
# Set to any value to run migrations and exit. Used by the deploy script.
MIGRATE_ONLY=
# Override media storage directory (default: $WEAVINE_DATA_DIR/media).
MEDIA_DIR=